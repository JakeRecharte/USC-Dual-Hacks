PORT=3000

# Retell dashboard → Settings → API Keys. Also used to verify x-retell-signature.
RETELL_API_KEY=

# The number you bought in Retell, E.164 (+1...). Required for outbound.
RETELL_FROM_NUMBER=
# Optional: agent used for outbound sweeps, if different from the number's default agent.
RETELL_OUTBOUND_AGENT_ID=

# Outbound safety. Comma-separated E.164 numbers of people who said yes.
CONSENTED_NUMBERS=
ALERTS_ENABLED=false
MAX_DIALS_PER_CLUSTER=25

# Leave unset. Only set to false if real Retell requests are being rejected and you need to debug.
# RETELL_VERIFY=false
