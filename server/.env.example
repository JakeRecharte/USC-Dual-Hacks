PORT=3000

# Retell dashboard → Settings → API Keys. Also used to verify x-retell-signature.
RETELL_API_KEY=

# The number you bought in Retell, E.164 (+1...).
RETELL_FROM_NUMBER=


# Leave unset. Only set to false if real Retell requests are being rejected and you need to debug.
# RETELL_VERIFY=false

# Phone of whoever plays dispatcher, E.164. Bypass calls are warm-transferred here.
DISPATCHER_NUMBER=
# Optional overrides for scripts/setup-retell.js
# RETELL_VOICE_ID=11labs-Marissa
# RETELL_MODEL=claude-5.5-haiku
# PUBLIC_URL=https://xxxx.ngrok-free.app

# Supabase, shared with the board (docs/SUPABASE_SETUP.md + docs/sql/calls.sql).
# Project Settings → API. The service-role key is secret: Railway and this file only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
